# =====================================================================
# InternApplier / ColdMailingAgent — Environment Configuration
# =====================================================================

# 1. Google Gemini API (Required for AI resume tailoring & company intelligence)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Gmail Outreach Credentials (Required for sending automated cold emails)
# Instructions:
# 1. Enable 2-Step Verification in Google Account: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
#    - Select app: "Mail", device: "Windows Computer" (or Other)
#    - Copy the generated 16-character password below:
EMAIL_ADDRESS=your.email@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 3. Candidate Personal Details (Optional override — defaults to profile.yaml)
YOUR_NAME=Your Full Name
YOUR_EMAIL=your.email@gmail.com
YOUR_PHONE=+91 9876543210
YOUR_COLLEGE=IIT Kharagpur
YOUR_YEAR_AND_DEGREE=3rd-year undergraduate at IIT Kharagpur
YOUR_TARGET_ROLE=remote data intern
YOUR_LINKEDIN=https://www.linkedin.com/in/your-profile/
YOUR_GITHUB=https://github.com/your-username

